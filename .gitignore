# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# Caches / tooling
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.pytype/

# Local config / secrets
.env
.env.*
!.env.example

# Runtime data
data/
memory/
*.db
*.sqlite
*.sqlite3
*.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE / editor
.vscode/
.idea/
*.iml
*.suo
*.user
*.userosscache
*.sln.docstates

# Node (kept for safety even if web removed)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Project local assistant/cache files
.claude/
.codex/

# Misc
*.tmp
*.temp
*.bak
*-implement-the-following-plan.txt

# Reproducible dependency graphs are release artifacts and must be committed.
!uv.lock
!requirements.lock

# Local operational artifacts (manual backups, pre-migration snapshots).
# The existing *.bak / data/ rules do not cover suffixed variants such as
# config.py.bak-20260919_054025 or data.pre-migration-<ts>/, which left them
# showing up as untracked noise in `git status`.
backups/
data.pre-migration-*/
*.bak-*
